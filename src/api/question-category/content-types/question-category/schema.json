{
  "kind": "collectionType",
  "collectionName": "question_categories",
  "info": {
    "singularName": "question-category",
    "pluralName": "question-categories",
    "displayName": "QuestionCategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer"
    },
    "heatingQuestions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::heating-question.heating-question",
      "mappedBy": "category"
    },
    "propertyQuestions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lifestyle-question.lifestyle-question",
      "mappedBy": "category"
    },
    "isOptionalCategory": {
      "type": "boolean",
      "default": false
    }
  }
}
