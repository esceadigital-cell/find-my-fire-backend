{
  "kind": "collectionType",
  "collectionName": "rule_profiles",
  "info": {
    "singularName": "rule-profile",
    "pluralName": "rule-profiles",
    "displayName": "RuleProfile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "maxGkg": {
      "type": "decimal"
    },
    "minEffPct": {
      "type": "decimal",
      "default": 65
    },
    "requireUleb": {
      "type": "boolean",
      "default": false
    },
    "wetbackMaxGkg": {
      "type": "decimal"
    },
    "installation": {
      "type": "enumeration",
      "default": "ok",
      "enum": [
        "ok",
        "replacement only",
        "no new build"
      ]
    },
    "propertySize": {
      "type": "enumeration",
      "default": "under 2ha",
      "enum": [
        "all",
        "under 2ha",
        "over 2ha"
      ]
    },
    "note": {
      "type": "text"
    },
    "legalText": {
      "type": "text"
    },
    "sourceUrl": {
      "type": "text"
    }
  }
}
