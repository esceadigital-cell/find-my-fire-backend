{
  "kind": "collectionType",
  "collectionName": "lifestyle_questions",
  "info": {
    "singularName": "lifestyle-question",
    "pluralName": "lifestyle-questions",
    "displayName": "Property questions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer"
    },
    "options": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "inputOption"
            },
            "options"
          ]
        }
      },
      "component": "question.lifestyle-question",
      "repeatable": true
    },
    "productField": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "fuelType",
        "installType",
        "wetback",
        "uleb",
        "maxOutputKw",
        "width",
        "height",
        "depth"
      ]
    },
    "inputOption": {
      "type": "enumeration",
      "default": "options",
      "enum": [
        "options",
        "number"
      ]
    },
    "operator": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "inputOption"
            },
            "number"
          ]
        }
      },
      "enum": [
        "equals",
        "not equals",
        "less or equal",
        "greater or equal"
      ]
    },
    "unit": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "inputOption"
            },
            "number"
          ]
        }
      }
    },
    "showIfKey": {
      "type": "string"
    },
    "followUps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lifestyle-question.lifestyle-question",
      "mappedBy": "dependsOn"
    },
    "dependsOn": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lifestyle-question.lifestyle-question",
      "inversedBy": "followUps"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::question-category.question-category",
      "inversedBy": "propertyQuestions"
    }
  }
}
