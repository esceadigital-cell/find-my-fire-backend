{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "fuelType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "wood",
        "gas",
        "electric"
      ]
    },
    "installType": {
      "type": "enumeration",
      "enum": [
        "freestanding",
        "inbuilt",
        "insert"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "maxOutputKw": {
      "type": "decimal"
    },
    "emissionsGkg": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "efficiencyPct": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "uleb": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "wetback": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      },
      "default": false
    },
    "width": {
      "type": "decimal"
    },
    "height": {
      "type": "decimal"
    },
    "depth": {
      "type": "decimal"
    },
    "markets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::market.market",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "brands": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand.brand"
    },
    "isOutdoor": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "bases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::base.base",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "installType"
            },
            "freestanding"
          ]
        }
      }
    },
    "emissionFactorMgMj": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "star_rating": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "gas"
          ]
        }
      },
      "min": 0,
      "max": 5
    },
    "clean_air_approved": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "zero_clearance_rated": {
      "type": "boolean",
      "default": false
    },
    "flue_type": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "fuelType"
            },
            "electric"
          ]
        }
      },
      "enum": [
        "direct vent",
        "powered direct vent",
        "ventless"
      ]
    },
    "remote_control": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      },
      "required": false
    },
    "smartheat_wifi": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      }
    },
    "external_fan": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fuelType"
            },
            "wood"
          ]
        }
      },
      "enum": [
        "Yes",
        "No",
        "Optional"
      ]
    },
    "productLinks": {
      "type": "component",
      "component": "product.product-link",
      "repeatable": true
    },
    "manufacturer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::brand.brand",
      "required": true
    }
  }
}
