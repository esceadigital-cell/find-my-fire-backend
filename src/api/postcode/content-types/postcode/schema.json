{
  "kind": "collectionType",
  "collectionName": "postcodes",
  "info": {
    "singularName": "postcode",
    "pluralName": "postcodes",
    "displayName": "Postcode"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "NZ",
        "AU"
      ]
    },
    "place": {
      "type": "string"
    },
    "lat": {
      "type": "decimal",
      "required": true
    },
    "lng": {
      "type": "decimal",
      "required": true
    },
    "region": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::region.region"
    }
  }
}
