{
  "kind": "collectionType",
  "collectionName": "heating_questions",
  "info": {
    "singularName": "heating-question",
    "pluralName": "heating-questions",
    "displayName": "HeatingQuestion"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer"
    },
    "options": {
      "type": "component",
      "component": "question.heating-option",
      "repeatable": true
    },
    "showIfKey": {
      "type": "string"
    },
    "followUps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::heating-question.heating-question",
      "mappedBy": "dependsOn"
    },
    "dependsOn": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::heating-question.heating-question",
      "inversedBy": "followUps"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::question-category.question-category",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "isDependingOnHeatDemand"
            },
            true
          ]
        }
      },
      "inversedBy": "heatingQuestions"
    },
    "isDependingOnHeatDemand": {
      "type": "boolean",
      "default": true
    },
    "extraDescription": {
      "type": "text"
    }
  }
}
